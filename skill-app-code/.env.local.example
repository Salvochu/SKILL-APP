# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API).
#
# NEXT_PUBLIC_ prefixed vars are safe to expose to the browser -- the anon
# key is designed for that as long as Row Level Security (RLS) is enabled
# on every table.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefixed NEXT_PUBLIC. Used by the GHL purchase webhook
# to create accounts via the Auth Admin API. From Settings -> API ->
# service_role (or an sb_secret_ key).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where Supabase email links (set-password) send the user back. Defaults to
# the request origin if unset; set it in production to the real domain.
NEXT_PUBLIC_SITE_URL=https://app.salvadorskfitness.com

# --- GHL purchase webhook (app/api/ghl/purchase) ---
# Shared secret that gates the endpoint. GHL's workflow Custom Webhook
# action does not sign its requests, so set this here and add the same
# value in GHL as an "Authorization: Bearer <secret>" or "x-webhook-secret"
# header. Generate one with:  openssl rand -hex 32
GHL_WEBHOOK_SECRET=your-long-random-secret
# The Ed25519 public key from GHL's Webhook Integration Guide is built in;
# only set this to override it if GHL rotates the key. Only used when
# GHL_WEBHOOK_SECRET is unset (signed native webhook trigger).
# GHL_WEBHOOK_PUBLIC_KEY=
# Legacy RSA key, only if you still receive X-WH-Signature webhooks.
# GHL_WEBHOOK_PUBLIC_KEY_RSA=
# If set, only purchases of this GHL product id are accepted.
# GHL_EXPECTED_PRODUCT_ID=
# Set to 1 in local dev to skip signature checks when replaying payloads.
# GHL_WEBHOOK_SKIP_VERIFY=
